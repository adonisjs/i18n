{
  "name": "@adonisjs/i18n",
  "description": "Internationalization for AdonisJS apps",
  "version": "3.0.0-next.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "build/index.js",
  "type": "module",
  "files": [
    "build",
    "!build/bin",
    "!build/tests"
  ],
  "exports": {
    ".": "./build/index.js",
    "./factories": "./build/factories/main.js",
    "./services/main": "./build/services/i18n.js",
    "./i18n_provider": "./build/providers/i18n_provider.js",
    "./plugins/edge": "./build/src/plugins/edge.js",
    "./types": "./build/src/types.js"
  },
  "scripts": {
    "pretest": "npm run lint",
    "test": "cross-env NODE_DEBUG=adonisjs:i18n c8 npm run quick:test",
    "typecheck": "tsc --noEmit",
    "clean": "del-cli build",
    "precompile": "npm run lint && npm run clean",
    "compile": "tsdown && tsc --emitDeclarationOnly --declaration",
    "build": "npm run compile",
    "prebenchmark": "npm run build",
    "benchmark": "node benchmarks/index.js",
    "release": "release-it",
    "version": "npm run build",
    "format": "prettier --write .",
    "prepublishOnly": "npm run build",
    "lint": "eslint",
    "quick:test": "node --import=@poppinss/ts-exec --enable-source-maps bin/test.ts",
    "docs": "typedoc",
    "copy:templates": "copyfiles --up 1 \"stubs/**/**/*.stub\" build",
    "postcompile": "npm run copy:templates"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.0.0-next.26",
    "@adonisjs/core": "^7.0.0-next.16",
    "@adonisjs/eslint-config": "^3.0.0-next.5",
    "@adonisjs/prettier-config": "^1.4.5",
    "@adonisjs/tsconfig": "^2.0.0-next.3",
    "@japa/assert": "^4.2.0",
    "@japa/file-system": "^3.0.0",
    "@japa/runner": "^5.0.0",
    "@poppinss/ts-exec": "^1.4.1",
    "@release-it/conventional-changelog": "^10.0.4",
    "@types/luxon": "^3.7.1",
    "@types/negotiator": "^0.6.4",
    "@types/node": "^25.0.3",
    "@vinejs/vine": "^4.2.0",
    "c8": "^10.1.3",
    "copyfiles": "^2.4.1",
    "cross-env": "^10.1.0",
    "del-cli": "^7.0.0",
    "edge.js": "^6.4.0",
    "eslint": "^9.39.2",
    "prettier": "^3.7.4",
    "release-it": "^19.1.0",
    "tsdown": "^0.18.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@poppinss/intl-formatter": "^3.1.0",
    "@poppinss/utils": "^7.0.0-next.4",
    "intl-messageformat": "^11.0.2",
    "luxon": "^3.7.2",
    "negotiator": "^1.0.0",
    "yaml": "^2.8.2"
  },
  "peerDependencies": {
    "@adonisjs/core": "^7.0.0-next.0",
    "@vinejs/vine": "^3.0.0 || ^4.0.0",
    "edge.js": "^6.0.2"
  },
  "peerDependenciesMeta": {
    "edge.js": {
      "optional": true
    },
    "@vinejs/vine": {
      "optional": true
    }
  },
  "author": "Harminder Virk <virk@adonisjs.com>",
  "contributors": [
    "Romain Lanz <romain.lanz@pm.me>",
    "Julien Ripouteau <julien@ripouteau.com>"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adonisjs/i18n.git"
  },
  "bugs": {
    "url": "https://github.com/adonisjs/i18n/issues"
  },
  "homepage": "https://github.com/adonisjs/i18n#readme",
  "keywords": [
    "intl",
    "localization",
    "translation",
    "i18n"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "tsdown": {
    "entry": [
      "./index.ts",
      "./services/i18n.ts",
      "./factories/main.ts",
      "./providers/i18n_provider.ts",
      "./src/types.ts",
      "./src/plugins/edge.ts"
    ],
    "outDir": "./build",
    "clean": true,
    "format": "esm",
    "minify": "dce-only",
    "fixedExtension": false,
    "dts": false,
    "treeshake": false,
    "sourcemaps": false,
    "target": "esnext"
  },
  "release-it": {
    "git": {
      "requireCleanWorkingDir": true,
      "requireUpstream": true,
      "commitMessage": "chore(release): ${version}",
      "tagAnnotation": "v${version}",
      "push": true,
      "tagName": "v${version}"
    },
    "github": {
      "release": true
    },
    "npm": {
      "publish": true,
      "skipChecks": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        }
      }
    }
  },
  "c8": {
    "reporter": [
      "text",
      "html"
    ],
    "exclude": [
      "tests/**"
    ]
  },
  "prettier": "@adonisjs/prettier-config"
}
